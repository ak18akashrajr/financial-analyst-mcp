# Copy this file to .env and fill in the values from your own Supabase project
# (Project Settings -> API). These are anon/publishable keys and are safe to
# expose client-side; do not put a service_role key here or in any VITE_-
# prefixed variable, since VITE_ vars are inlined into the client bundle.

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
